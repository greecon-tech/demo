[Unit]
Description=Greecon edge simulator (bring-up/testing telemetry source — NOT for a live pilot)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=/etc/greecon/edge.env
WorkingDirectory=/opt/greecon/apps/edge-simulator
ExecStart=/usr/bin/node /opt/greecon/apps/edge-simulator/dist/index.js
Restart=always
RestartSec=5
User=greecon
Group=greecon
StandardOutput=journal
StandardError=journal

# install.sh installs this unit but deliberately does not enable or start it — see
# docs/14-edge-hardware-deployment.md. Enable it only to prove the broker/agent/API pipeline
# works before real device drivers exist ("systemctl enable --now greecon-edge-simulator"), then
# disable it and enable the real driver process(es) instead. It publishes synthetic sine-wave
# readings, not anything read from real equipment.
[Install]
WantedBy=multi-user.target
