[Unit]
Description=Greecon edge agent (MQTT -> cloud API telemetry bridge)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=/etc/greecon/edge.env
WorkingDirectory=/opt/greecon/apps/edge-agent
ExecStart=/usr/bin/node /opt/greecon/apps/edge-agent/dist/index.js
Restart=always
RestartSec=5
User=greecon
Group=greecon
# Buffered readings only live in process memory (see docs/13-pilot-readiness.md) — a restart
# during an outage loses whatever hadn't flushed yet, which is why RestartSec is short but not
# aggressive enough to thrash if the API is down for a while.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
