# Site-specific configuration for the edge box. Copy to /etc/greecon/edge.env and fill in the
# real values for this site — see docs/14-edge-hardware-deployment.md.
#
# Every ID below is a UUID from the platform's seed/site data. There is no provisioning UI yet
# (see docs/13-pilot-readiness.md, "Site/device/point provisioning has no CRUD") — get these from
# whoever set up the tenant/site in Postgres until that exists.

TENANT_ID=11111111-1111-4111-8111-111111111111
SITE_ID=
GATEWAY_ID=

# Local broker on this same box — do not point this at a remote/public broker (see the Mosquitto
# config note in the deployment guide on why it's bound to loopback only).
MQTT_URL=mqtt://127.0.0.1:1883

# The cloud API is deliberately not exposed on the public internet (docs/07-security-and-rbac.md,
# docs/11-deployment-railway.md) — this URL only resolves from inside the same private network
# (e.g. over the WireGuard/Tailscale tunnel set up in the deployment guide's prerequisite step).
API_URL=

# Least-privileged role that still holds telemetry:ingest. Do not use owner/admin here.
API_ROLE=operator

# How often the agent retries anything buffered while the API was unreachable.
FLUSH_INTERVAL_MS=10000
