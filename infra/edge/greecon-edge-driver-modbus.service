[Unit]
Description=Greecon Modbus TCP driver (real field telemetry -> local MQTT broker)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=/etc/greecon/edge.env
Environment=MODBUS_CONFIG_PATH=/etc/greecon/modbus.json
WorkingDirectory=/opt/greecon/apps/edge-driver-modbus
ExecStart=/usr/bin/node /opt/greecon/apps/edge-driver-modbus/dist/index.js
Restart=always
RestartSec=5
User=greecon
Group=greecon
StandardOutput=journal
StandardError=journal

# See docs/16-modbus-driver.md for /etc/greecon/modbus.json's format. install.sh does not create
# this file or enable this unit — there's nothing to configure it with until real devices are
# provisioned via the Sites/Assets/Devices/Points API, so wiring this up is a per-site step done
# once that provisioning exists, not part of the base image.
[Install]
WantedBy=multi-user.target
