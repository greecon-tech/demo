# Local development placeholders only. No real secrets belong in source control.
# Production secrets are read from Google Secret Manager (see infra/terraform).

# apps/api
API_PORT=4000
DATABASE_URL=postgres://greecon_local:greecon_local_password@localhost:5432/greecon
GREECON_DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
# Signs and verifies session tokens issued by POST /auth/login (docs/07-security-and-rbac.md).
# This placeholder is fine for local dev; production must use a real random secret from Google
# Secret Manager, never a value committed to source control.
JWT_SECRET=local-dev-only-change-me

# apps/web
GREECON_API_URL=http://localhost:4000

# apps/edge-simulator
MQTT_URL=mqtt://localhost:1883
TENANT_ID=11111111-1111-4111-8111-111111111111
SITE_ID=22222222-2222-4222-8222-222222222201
GATEWAY_ID=77777777-7777-4777-8777-777777777701
